{
	"name": "aaa-agent",
	"version": "0.4.0",
	"description": "AAA Agent — compatibility SDK and CLI for the lightweight model-adaptive package suite",
	"type": "module",
	"bin": {
		"aaa": "src/cli.ts"
	},
	"scripts": {
		"check": "biome check . && bun run check:types && bun run check:packages",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"check:packages": "bun scripts/check-package-boundaries.ts",
		"test": "bun test --parallel ../aaa-workspace/test/*.test.ts ../aaa-app/test/*.test.ts"
	},
	"dependencies": {
		"@aaa-agent/app": "workspace:*",
		"@aaa-agent/providers": "workspace:*",
		"@aaa-agent/runtime": "workspace:*",
		"@aaa-agent/workspace": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"files": [
		"src",
		"README.md",
		"CHANGELOG.md"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./*": {
			"types": "./src/*.ts",
			"import": "./src/*.ts"
		}
	}
}
