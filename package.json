	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.3",
		"@types/bun": "catalog:",
		"@typescript/native-preview": "7.0.0-dev.20260707.2"
	},
	"engines": {
		"bun": ">=1.3.14"
	}
}
