{
	"name": "aaa-agent-workspace",
	"version": "0.4.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"workspaces": {
		"packages": [
			"packages/*"
		],
		"catalog": {
			"@types/bun": "^1.3.14"
		}
	},
